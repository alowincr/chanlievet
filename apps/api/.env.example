# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://chanlievet:chanlievet@localhost:5432/chanlievet?schema=public"

# Servidor
PORT=4000
NODE_ENV=development

# Autenticación de staff (panel admin / veterinario)
JWT_SECRET="cambia-este-secreto-en-produccion-por-favor"
JWT_EXPIRES_IN="12h"

# CORS: orígenes del frontend separados por coma
CORS_ORIGIN="http://localhost:3000"

# Umbral para marcar productos con stock bajo
LOW_STOCK_THRESHOLD=5

# Citas simultáneas permitidas por franja de 30 minutos (1 = atención exclusiva)
SLOT_CAPACITY=1

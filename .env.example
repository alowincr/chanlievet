# Puerto del host para PostgreSQL de Docker (5433 evita conflictos con un PG local).
POSTGRES_PORT=5433

# Secreto para firmar los JWT del personal.
# Genera uno real antes de levantar Docker:
#   openssl rand -hex 32
# (Docker Compose falla si esta variable queda vacía).
JWT_SECRET=

# URL del API visible desde el navegador (se incrusta al construir la web).
NEXT_PUBLIC_API_URL=http://localhost:4000
